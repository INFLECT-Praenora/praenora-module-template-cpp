{
  "kind": "message-type",
  "format_version": "0.1.0",
  "id": "my-module.summary",
  "version": "0.1.0",
  "status": "draft",
  "summary": "Per-series summaries of one tick's usable observations (template sample).",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "time_unit",
      "window",
      "series"
    ],
    "properties": {
      "time_unit": {
        "type": "string",
        "minLength": 1
      },
      "window": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "series": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "series_id",
            "variable_id",
            "count",
            "mean",
            "min",
            "max",
            "last_time",
            "last_value"
          ],
          "properties": {
            "series_id": {
              "type": "string",
              "minLength": 1
            },
            "variable_id": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "mean": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "last_time": {
              "type": "number"
            },
            "last_value": {
              "type": "number"
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
