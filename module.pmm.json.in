{
  "kind": "module-manifest",
  "format_version": "@PRAENORA_MODULE_MANIFEST_FORMAT_VERSION@",
  "module": {
    "name": "@PRAENORA_MODULE_NAME@",
    "version": "@PRAENORA_MODULE_VERSION@",
    "summary": "Summarizes each series of an observation batch (template sample).",
    "authors": ["The Praenora developers"],
    "repository": "https://github.com/tjsego/praenora-module-template-cpp"
  },
  "abi": { "major": @PRAENORA_ABI_MAJOR@, "minor": @PRAENORA_ABI_MINOR@ },
  "pmp_version": "@PRAENORA_PMP_VERSION@",
  "sdk_version": "@PRAENORA_SDK_VERSION@",
  "library": { "path": "@PRAENORA_MODULE_LIBRARY_FILE@" },
  "platform": { "os": "@PRAENORA_MODULE_OS@", "arch": "@PRAENORA_MODULE_ARCH@" },
  "capabilities": @PRAENORA_MODULE_CAPABILITIES_JSON@,
  "requires": @PRAENORA_MODULE_REQUIRES_JSON@,
  "parameters_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "min_count": {
        "description": "Series with fewer usable observations in a tick are left out.",
        "type": "integer",
        "minimum": 1,
        "default": 1
      }
    },
    "additionalProperties": false
  },
  "features": {
    "concurrency": "instance",
    "cancellation": false,
    "diagnostics": true,
    "self_test": false
  },
  "tests": { "vectors": "@PRAENORA_MODULE_TEST_VECTORS@" }
}
