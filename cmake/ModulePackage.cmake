# The module's installation and its archive (CPack, the target package; PACKAGE with Visual Studio).
#
# Everything installed is in the install component `module`, and the archive holds that component
# only, so no file of a dependency or of the tests can reach it:
#
#   lib/praenora/modules/<name>/                 the library, its manifest and its test vectors
#                                                (praenora_add_module(INSTALL_DESTINATION ...))
#   share/praenora/module-catalog/               the catalog entries of catalog/, in the catalog's
#                                                layout (capabilities/<id>/<version>.json, ...)
#   share/praenora/licenses/<name>/              the repository's LICENSE* files, and the license of
#                                                nlohmann/json when it was downloaded and compiled in
#
# Copied into a runtime installation's prefix, the module is found by the runtime without further
# options, and PRAENORA_CATALOG_PATH=<prefix>/share/praenora/module-catalog (or --catalog-path)
# adds its catalog entries. Several modules' archives merge into one module-catalog: the same
# entry lands on the same path. The runtime's own share/praenora/catalog holds its built-in
# entries, which must not be added again.
#
# The archive is build/<preset>/package/<name>-<version>-<os>-<arch>-<compiler>-<config>.tar.xz
# (.zip on Windows), with a top-level directory of the same name and a .sha256 file beside it.
# <os> and <arch> are the manifest's (linux|macos|windows, x86_64|arm64), <compiler> is
# gcc<major>, clang<major>, appleclang<major> or msvc<toolset>, and <config> is the packaged
# configuration in lower case: CMAKE_BUILD_TYPE, or with a multi-configuration generator the one
# cpack -C names (the package target passes the build's).

include_guard(GLOBAL)

set(MODULE_CATALOG_INSTALL_DIR "share/praenora/module-catalog")
set(MODULE_LICENSE_INSTALL_DIR "share/praenora/licenses/${MODULE_NAME}")

if(MODULE_HAS_CATALOG)
    install(DIRECTORY "${MODULE_CATALOG_DIR}/" DESTINATION "${MODULE_CATALOG_INSTALL_DIR}"
        COMPONENT module FILES_MATCHING PATTERN "*.json")
endif()
file(GLOB _module_licenses "${PROJECT_SOURCE_DIR}/LICENSE*")
if(_module_licenses)
    install(FILES ${_module_licenses} DESTINATION "${MODULE_LICENSE_INSTALL_DIR}"
        COMPONENT module)
endif()
if(DEFINED nlohmann_json_SOURCE_DIR AND EXISTS "${nlohmann_json_SOURCE_DIR}/LICENSE.MIT")
    install(FILES "${nlohmann_json_SOURCE_DIR}/LICENSE.MIT"
        DESTINATION "${MODULE_LICENSE_INSTALL_DIR}/nlohmann_json" COMPONENT module)
endif()

# The archive's name: <name>-<version>-<os>-<arch>-<compiler>, then -<config>.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(_module_os "macos")
else()
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" _module_os)
endif()
if(CMAKE_OSX_ARCHITECTURES)
    set(_module_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_module_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(CMAKE_VS_PLATFORM_NAME)
    set(_module_arch "${CMAKE_VS_PLATFORM_NAME}")
else()
    set(_module_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
string(TOLOWER "${_module_arch}" _module_arch)
if(_module_arch MATCHES "^(arm64|aarch64)$")
    set(_module_arch "arm64")
elseif(_module_arch MATCHES "^(x86_64|amd64|x64)$")
    set(_module_arch "x86_64")
endif()
string(REGEX MATCH "^[0-9]+" _module_compiler_major "${CMAKE_CXX_COMPILER_VERSION}")
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND MSVC_TOOLSET_VERSION)
    set(_module_compiler "msvc${MSVC_TOOLSET_VERSION}")
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(_module_compiler "gcc${_module_compiler_major}")
else()
    string(TOLOWER "${CMAKE_CXX_COMPILER_ID}${_module_compiler_major}" _module_compiler)
endif()
set(MODULE_PACKAGE_NAME_PREFIX
    "${MODULE_NAME}-${PROJECT_VERSION}-${_module_os}-${_module_arch}-${_module_compiler}")

string(TOLOWER "${CMAKE_BUILD_TYPE}" _module_config)
if(_module_config STREQUAL "")
    set(_module_config "noconfig")
endif()
# Read by cpack after CPackConfig.cmake: a multi-configuration build names its configuration then.
set(_module_cpack_project_config "${PROJECT_BINARY_DIR}/ModuleCPackProjectConfig.cmake")
file(CONFIGURE OUTPUT "${_module_cpack_project_config}" @ONLY CONTENT [=[
# Generated by cmake/ModulePackage.cmake: the archive's name ends in the packaged configuration.
if(NOT "${CPACK_BUILD_CONFIG}" STREQUAL "")
    string(TOLOWER "${CPACK_BUILD_CONFIG}" _module_config)
    set(CPACK_PACKAGE_FILE_NAME "@MODULE_PACKAGE_NAME_PREFIX@-${_module_config}")
endif()
]=])

set(CPACK_PACKAGE_NAME "${MODULE_NAME}")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "${MODULE_PACKAGE_NAME_PREFIX}-${_module_config}")
set(CPACK_PROJECT_CONFIG_FILE "${_module_cpack_project_config}")
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};module;/")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TXZ)
endif()
set(CPACK_SOURCE_GENERATOR "${CPACK_GENERATOR}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/package")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_THREADS 0)
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
message(STATUS "Module package: ${MODULE_PACKAGE_NAME_PREFIX}-<config>")
